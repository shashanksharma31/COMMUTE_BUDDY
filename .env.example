# MAPBOX_ACCESS_TOKEN: Mapbox Streets v12 vector/raster map tiles (LeafletMapView)
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN

# ORS_API_KEY: OpenRouteService API key for road routing, distances, and polylines
ORS_API_KEY=YOUR_ORS_API_KEY

# TOMTOM_API_KEY: TomTom API key for real-time road traffic congestion & delays
TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY

# HERE_API_KEY: HERE Maps API key for fallback traffic & transit routing
HERE_API_KEY=YOUR_HERE_API_KEY

# OTD_DELHI_API_KEY: Open Transit Data Delhi API key for live DTC/DIMTS bus GTFS-RT feeds
OTD_DELHI_API_KEY=YOUR_OTD_DELHI_API_KEY

# GOOGLE_ROUTES_API_KEY: Google Routes API key for multi-modal transit directions
GOOGLE_ROUTES_API_KEY=YOUR_GOOGLE_ROUTES_API_KEY

# TRAIN_PRIMARY_API_KEY: Primary Indian Railways live train status & schedule API key
TRAIN_PRIMARY_API_KEY=YOUR_TRAIN_PRIMARY_API_KEY

# TRAIN_SECONDARY_API_KEY: Secondary fallback Indian Railways API key
TRAIN_SECONDARY_API_KEY=YOUR_TRAIN_SECONDARY_API_KEY
